{
  "name": "papers-mcp",
  "version": "2.0.0",
  "description": "MCP server for academic paper search and analysis",
  "main": "build/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "dev": "tsc --watch",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "test:live": "npm run build && node tests/live.mjs"
  },
  "keywords": ["mcp", "papers", "research", "academic"],
  "author": {
    "name": "Xingyu Chen",
    "email": "guangxiangdebizi@gmail.com",
    "url": "https://github.com/guangxiangdebizi/"
  },
  "license": "Apache-2.0",
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "@modelcontextprotocol/node": "2.1.2",
    "@citation-js/core": "0.9.0",
    "@citation-js/plugin-bibtex": "0.9.0",
    "@citation-js/plugin-ris": "0.9.0",
    "cheerio": "1.2.0",
    "fast-xml-parser": "5.3.0",
    "ipaddr.js": "2.3.0",
    "pdfjs-dist": "4.10.38",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "22.19.1",
    "bibtex-parse-js": "0.0.24",
    "typescript": "5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/guangxiangdebizi/papers-mcp.git"
  },
  "homepage": "https://github.com/guangxiangdebizi/papers-mcp#readme",
  "engines": { "node": ">=20.19" }
}
